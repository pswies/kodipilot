{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 7am on monday"],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "labels": ["dependencies"],
  "description": "CI runs `go mod tidy -diff`, so module updates must leave go.mod/go.sum tidy.",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "The Charm stack moves together (carried over from the old Dependabot `charm` group).",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["charm.land/**", "github.com/charmbracelet/**"],
      "groupName": "charm"
    }
  ]
}
